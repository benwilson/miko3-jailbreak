<?xml version="1.0" encoding="utf-8"?>
<!-- OpenMiko Boot Agent — a purpose-built APK that brings adb-over-wifi up at every boot, headless,
     with NO Termux and NO Nova dependency. Replicates how any launcher/utility auto-starts: a manifest
     BOOT_COMPLETED receiver. On boot it execs /system/bin/su (world-exec setuid root on this unit) to
     neuter the anti-tamper reboot watchdog and then enable adb tcp 5555. See build.sh + README.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.openmiko.bootagent"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="OpenMiko Boot"
        android:allowBackup="false">

        <!-- Launcher activity: exists so the app can be started once (pm install + am start over the first
             adb session) to clear Android's post-install "stopped" state, which arms the boot receiver. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <receiver android:name=".BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
