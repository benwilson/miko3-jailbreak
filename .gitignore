# Firmware images, dumps, and partition blobs — large and often device-specific
firmware/*
!firmware/.gitkeep
!firmware/README.md
# Track only the per-dump manifests/readmes (hashes are safe to publish)
!firmware/dump/
!firmware/dump/README.md
!firmware/dump/SHA256SUMS
!firmware/dump-parental-locked/
!firmware/dump-parental-locked/README.md
!firmware/dump-parental-locked/SHA256SUMS
firmware/**/*.img
*.img
*.bin
*.dump
*.tar.md5
*.zip

# ADB / logcat captures
recon/captures/*.log
logcat-*.txt
recon/captures/

# Extracted filesystems
extracted/
out/
build/

# Secrets: device serials, tokens, wifi creds pulled off the device
secrets/
*.pem
*.key
.env
.env.*

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Third-party tool clones (track provenance in a note, not the source)
tools/mtkclient/

tools/aoa-inject/.venv/

# Compound Engineering local scratch
.context/compound-engineering/
.compound-engineering/

# pi tool local config
.pi/

# Extracted archive contents and decompiled dumps — regenerate from the
# source .apk/.zip rather than tracking, they're large and derived
*_extracted/
*-extracted/
*_jadx/
tools/extracted-system/
hooks/sd-free-test/
hooks/sd-free/miko3-test/

# Downloaded/recon'd APKs and third-party jars — large binaries, not source
*.apk
*.jar
*.class

# autonomous-recovery.py's own runtime cache of staged Route A files
scripts/route-a-cache/
tools/third_party/
tools/detector-export/
