<?xml version="1.0" encoding="utf-8"?>
<!-- Miko 3 voice-conversation mode. For now this carries only U1's wake-word
     spike Activity (vendor engine in our APK, KTD7); U6 replaces it with the
     real mode Activity, launcher integration, and settings. See
     docs/plans/2026-09-17-1617-feat-autonomous-voice-mode-plan.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.miko3.mode.voice"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <application
        android:label="Miko3 Voice"
        android:allowBackup="false">

        <!-- Launched by hand over adb for the spike (am start -n
             com.miko3.mode.voice/.WakeWordSpikeActivity); a string extra
             "source" = "recognition" switches the capture source, see the
             Activity's own comment. -->
        <activity android:name=".WakeWordSpikeActivity" android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
